{
  "name": "@activityplug/hollo",
  "version": "0.1.0",
  "description": "Hollo adapter for ActivityPlug.",
  "keywords": [
    "activitypub",
    "fediverse",
    "hollo",
    "typescript"
  ],
  "homepage": "https://github.com/Nebu1eto/activityplug",
  "bugs": {
    "url": "https://github.com/Nebu1eto/activityplug/issues"
  },
  "license": "Apache-2.0 OR MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nebu1eto/activityplug.git",
    "directory": "packages/hollo"
  },
  "files": [
    "dist/*.mjs",
    "dist/*.d.mts",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "rolldown -c ../../rolldown.config.ts --configLoader native",
    "pack:dry-run": "pnpm pack --dry-run",
    "prepack": "pnpm build",
    "test": "node --experimental-strip-types ../../scripts/run-package-tests.ts"
  },
  "dependencies": {
    "@activityplug/mastodon-base": "workspace:^",
    "ky": "^2.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@activityplug/e2e-fixtures": "workspace:*",
    "@activityplug/test-fixtures": "workspace:*"
  },
  "peerDependencies": {
    "@activityplug/core": "workspace:^"
  },
  "engines": {
    "node": ">=26"
  }
}
