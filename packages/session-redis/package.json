{
  "name": "@activityplug/session-redis",
  "version": "1.0.1",
  "description": "Redis auth session and lifecycle storage for ActivityPlug server mode.",
  "keywords": [
    "activitypub",
    "fediverse",
    "session-redis",
    "typescript"
  ],
  "homepage": "https://github.com/Nebu1eto/activityplug",
  "bugs": {
    "url": "https://github.com/Nebu1eto/activityplug/issues"
  },
  "license": "Apache-2.0 OR MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nebu1eto/activityplug.git",
    "directory": "packages/session-redis"
  },
  "files": [
    "dist/*.mjs",
    "dist/*.d.mts",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "rolldown -c ../../rolldown.config.ts --configLoader native",
    "pack:dry-run": "pnpm pack --dry-run",
    "prepack": "pnpm build",
    "test": "node --experimental-strip-types ../../scripts/run-package-tests.ts",
    "test:integration": "node --experimental-strip-types ../../scripts/run-package-tests.ts --integration"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "ioredis": "^6.0.0"
  },
  "peerDependencies": {
    "@activityplug/core": "workspace:^",
    "@activityplug/server": "workspace:^",
    "ioredis": "^6.0.0"
  },
  "engines": {
    "node": ">=26"
  }
}
