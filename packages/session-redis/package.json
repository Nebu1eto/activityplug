{
  "name": "@activityplug/session-redis",
  "version": "0.0.0",
  "description": "Redis auth session storage for ActivityPlug server mode.",
  "license": "Apache-2.0 OR MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "pack:dry-run": "pnpm pack --dry-run",
    "prepack": "pnpm build",
    "test": "node --experimental-strip-types ../../scripts/run-package-tests.ts",
    "test:integration": "node --experimental-strip-types ../../scripts/run-package-tests.ts --integration"
  },
  "dependencies": {
    "@activityplug/core": "workspace:*",
    "@activityplug/server": "workspace:*",
    "ioredis": "^5.8.2"
  }
}
