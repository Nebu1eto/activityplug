exports[`server capability snapshots > hackerspub > adapter 1`] = `"hackerspub"`;

exports[`server capability snapshots > hackerspub > capabilities 1`] = `
{
  "accounts.lookupByHandle": "supported:static",
  "accounts.lookupById": "supported:static",
  "accounts.relationships": "unsupported:static:HackersPub account relationships are not mapped yet.",
  "auth.oauth.authorizationCode": "unsupported:probe:HackersPub does not use OAuth.",
  "auth.tokenInjection": "supported:static",
  "instance.nodeInfo": "supported:static",
  "media.upload": "unsupported:static:HackersPub media uploads are not mapped yet.",
  "polls.create": "unsupported:static:HackersPub poll creation is not mapped yet.",
  "polls.read": "unsupported:static:HackersPub poll reads are not mapped yet.",
  "polls.vote": "unsupported:static:HackersPub poll voting is not mapped yet.",
  "posts.create": "unsupported:static:HackersPub compose is not mapped yet.",
  "posts.delete": "unsupported:static:HackersPub post deletion is not mapped yet.",
  "posts.quote": "unsupported:static:HackersPub quote posts are not mapped yet.",
  "posts.read": "supported:static",
  "posts.reply": "unsupported:static:HackersPub replies are not mapped yet.",
  "search.accounts": "supported:static",
  "search.hashtags": "unsupported:static:HackersPub hashtag search is not mapped by this adapter yet.",
  "search.posts": "supported:static",
  "social.block": "unsupported:static:HackersPub social actions are not mapped yet.",
  "social.bookmark": "unsupported:static:HackersPub social actions are not mapped yet.",
  "social.boost": "unsupported:static:HackersPub social actions are not mapped yet.",
  "social.favourite": "unsupported:static:HackersPub social actions are not mapped yet.",
  "social.follow": "unsupported:static:HackersPub social actions are not mapped yet.",
  "social.mute": "unsupported:static:HackersPub social actions are not mapped yet.",
  "social.reaction": "unsupported:static:HackersPub social actions are not mapped yet.",
  "timelines.hashtag": "unsupported:static:HackersPub hashtag timelines are not mapped yet.",
  "timelines.local": "supported:static",
  "timelines.public": "supported:static",
}
`;

exports[`server capability snapshots > hollo > adapter 1`] = `"hollo"`;

exports[`server capability snapshots > hollo > capabilities 1`] = `
{
  "accounts.lookupByHandle": "supported:static",
  "accounts.lookupById": "supported:static",
  "accounts.relationships": "unsupported:static:Hollo account relationship lookup is not mapped by this adapter yet.",
  "auth.oauth.authorizationCode": "supported:oauth",
