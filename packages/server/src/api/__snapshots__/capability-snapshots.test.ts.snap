  "instance.nodeInfo": "supported:static",
  "media.upload": "supported:static",
  "polls.create": "unsupported:static:Hollo poll creation is not mapped because compose is not mapped yet.",
  "posts.create": "unsupported:static:Hollo compose is not mapped by this adapter yet.",
  "posts.delete": "unsupported:static:Hollo post deletion is not mapped by this adapter yet.",
  "posts.quote": "unsupported:static:This adapter does not expose a stable quote-post API.",
  "posts.read": "supported:static",
  "posts.reply": "unsupported:static:Hollo replies are not mapped because compose is not mapped yet.",
  "search.accounts": "supported:static",
  "search.hashtags": "unsupported:static:Hollo hashtag search is a stub in the upstream API.",
  "search.posts": "supported:static",
  "social.block": "supported:static",
  "social.bookmark": "unsupported:static:Hollo post social actions are not mapped by this adapter yet.",
  "social.boost": "unsupported:static:Hollo post social actions are not mapped by this adapter yet.",
  "social.favourite": "unsupported:static:Hollo post social actions are not mapped by this adapter yet.",
  "social.follow": "supported:static",
  "social.mute": "supported:static",
  "social.reaction": "unsupported:static:Mastodon-compatible base APIs do not assume emoji reaction support.",
  "timelines.hashtag": "unsupported:static:Hollo hashtag timelines are not mapped by this adapter yet.",
  "timelines.home": "supported:static",
  "timelines.local": "supported:static",
  "timelines.public": "supported:static",
}
`;

