{
  "name": "@activityplug/server",
  "version": "0.1.0",
  "description": "GraphQL and HTTP server surfaces for ActivityPlug.",
  "keywords": [
    "activitypub",
    "fediverse",
    "server",
    "typescript"
  ],
  "homepage": "https://github.com/Nebu1eto/activityplug",
  "bugs": {
    "url": "https://github.com/Nebu1eto/activityplug/issues"
  },
  "license": "Apache-2.0 OR MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nebu1eto/activityplug.git",
    "directory": "packages/server"
  },
  "bin": {
    "activityplug-server": "./dist/bin.mjs"
  },
  "files": [
    "dist/*.mjs",
    "dist/*.d.mts",
    "README.md",
    "README.ko.md",
    "README.ja.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "rolldown -c rolldown.config.ts --configLoader native",
    "pack:dry-run": "pnpm pack --dry-run",
    "prepack": "pnpm build",
    "test": "node --experimental-strip-types ../../scripts/run-package-tests.ts"
  },
  "dependencies": {
    "@activityplug/core": "workspace:*",
    "@activityplug/hackerspub": "workspace:*",
    "@activityplug/hollo": "workspace:*",
    "@activityplug/mastodon": "workspace:*",
    "@activityplug/misskey": "workspace:*",
    "@activityplug/pleroma": "workspace:*",
    "@hono/node-server": "^2.0.8",
    "@logtape/logtape": "^2.2.4",
    "@optique/core": "^1.1.1",
    "@optique/run": "^1.1.1",
    "@pothos/core": "^4.13.1",
    "graphql": "^17.0.2",
    "hono": "^4.12.29",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@activityplug/e2e-fixtures": "workspace:*",
    "@activityplug/test-fixtures": "workspace:*",
    "@types/ws": "^8.18.1"
  },
  "engines": {
    "node": ">=26"
  }
}
