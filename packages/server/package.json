{
  "name": "@activityplug/server",
  "version": "0.0.0",
  "description": "GraphQL and HTTP server surfaces for ActivityPlug.",
  "license": "Apache-2.0 OR MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
