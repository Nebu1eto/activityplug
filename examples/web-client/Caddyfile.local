https://{$CADDY_HOST:localhost} {
	tls internal
	encode zstd gzip
	route {
		@health path /health
		reverse_proxy @health server:4000 {
			header_up X-Forwarded-For {remote_host}
			header_up -X-Real-IP
		}

		@browser path /v1/browser/*
		reverse_proxy @browser server:4000 {
			header_up X-Forwarded-For {remote_host}
			header_up -X-Real-IP
		}

		@existingAsset {
			path /assets/*
			file
		}
		handle @existingAsset {
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}
		handle /assets/* {
			header Cache-Control "no-store"
			file_server
		}

		handle {
			try_files {path} /index.html
			file_server
		}
	}
}
