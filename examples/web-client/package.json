{
  "name": "@activityplug/example-web-client",
  "version": "0.0.2",
  "private": true,
  "description": "Sample web client for ActivityPlug.",
  "license": "Apache-2.0 OR MIT",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "dev": "vite --host 0.0.0.0",
    "preview": "vite preview --host 0.0.0.0",
    "start:server": "tsx src/server.ts",
    "test": "vitest run",
    "test:dom": "vitest run --environment jsdom",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "@activityplug/hackerspub": "workspace:*",
    "@activityplug/hollo": "workspace:*",
    "@activityplug/mastodon": "workspace:*",
    "@activityplug/misskey": "workspace:*",
    "@activityplug/pleroma": "workspace:*",
    "@activityplug/server": "workspace:*",
    "@activityplug/session-postgres": "workspace:*",
    "@activityplug/session-redis": "workspace:*",
    "@hono/node-server": "^2.1.0",
    "@logtape/logtape": "^2.3.0",
    "@simplewebauthn/browser": "13.3.0",
    "@tanstack/react-query": "5.101.4",
    "dompurify": "3.4.13",
    "graphql": "^17.0.2",
    "hono": "^4.13.0",
    "ioredis": "6.0.0",
    "jotai": "2.20.2",
    "pg": "8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/node": "26.1.2",
    "@types/pg": "8.20.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "30.0.1",
    "tsx": "4.23.8",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
