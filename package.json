{
  "name": "activityplug",
  "version": "0.0.0",
  "private": true,
  "description": "Unified proxy APIs and TypeScript adapters for ActivityPub software.",
  "license": "Apache-2.0 OR MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --sort build",
    "format": "oxfmt . && hongdown --write",
    "format:check": "oxfmt --check . && hongdown --check",
    "format:md": "hongdown --write",
    "format:md:check": "hongdown --check",
    "hooks:install": "lefthook install",
    "lint": "oxlint --type-aware",
    "pack:dry-run": "pnpm -r --sort --filter './packages/*' --if-present pack:dry-run",
    "test": "vitest run --passWithNoTests",
    "test:packages": "pnpm -r --sort --if-present test",
    "test:integration": "ACTIVITYPLUG_INTEGRATION=1 vitest run --passWithNoTests",
    "typecheck": "pnpm -r --sort build && tsc -b"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@types/node": "^25.6.0",
    "hongdown": "^0.3.10",
    "lefthook": "^2.1.6",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.61.0",
    "oxlint-tsgolint": "^0.22.0",
    "tsdown": "^0.21.10",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=10 <11"
  },
  "packageManager": "pnpm@10.33.2"
}
